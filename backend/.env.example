# Application
APP_NAME=UniSphere
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# Database — SQLite for local development; PostgreSQL-ready via SQLAlchemy URL
# Example Postgres: postgresql+psycopg://user:pass@localhost:5432/unisphere
DATABASE_URL=sqlite:///./unisphere.db

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI provider. Leave empty to use the rule-based Success Coach.
# Never put this value in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Scheduler
ENABLE_SCHEDULER=true
REMINDER_TIMEZONE=Asia/Kolkata

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate limits
AUTH_RATE_LIMIT=10/minute
